# Variables d'environnement de Mialigo — modèle SANS secret.
# Copie locale : `npm run check-env` crée .env.local à partir de ce fichier,
# puis remplacez les valeurs bidon ci-dessous par les vraies.
# Où les trouver : dashboard Supabase → Project Settings → API.
# En production, ces variables sont définies dans Vercel (Settings → Environment Variables).

# URL du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique « anon » (jamais la clé service_role !)
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
